{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verification_token": {"type": ["string", "null"]},
    "reviewed_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verdict": {
      "type": "string",
      "enum": ["reviewed", "pass", "partial", "fail"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "declared_changes_assessed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "note_id": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["accepted", "rejected"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required": ["note_id", "note", "verdict", "evidence"]
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "abstraction",
              "architecture",
              "behavior_regression",
              "comments_docs",
              "compatibility",
              "complexity",
              "configuration",
              "dead_code",
              "defensive_code",
              "duplication",
              "indirection",
              "layering",
              "module_boundaries",
              "naming",
              "readability",
              "state",
              "test_regression",
              "tests",
              "types",
              "validation",
              "other"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "symbols": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "harm": {"type": "string", "minLength": 1},
          "proposed_change": {"type": "string", "minLength": 1},
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "chesterton": {"type": "string", "minLength": 1}
        },
        "required": [
          "category",
          "title",
          "evidence",
          "files",
          "symbols",
          "harm",
          "proposed_change",
          "invariants",
          "risk",
          "priority",
          "confidence",
          "verification",
          "chesterton"
        ]
      }
    }
  },
  "required": ["verdict", "summary", "findings", "declared_changes_assessed", "verification_token", "reviewed_files"]
}
